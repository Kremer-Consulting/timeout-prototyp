{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Farben und Schriften der Live-Seite timeoutannweiler.de, erfasst am 2026-10-09, sowie Zielwerte des Redesigns unter \"target\". Erläuterung im Markenhandbuch.",
  "color": {
    "brand": {
      "beige": {
        "$type": "color",
        "$value": "#C8BDA8",
        "$description": "Haupt-Hintergrund (Startseite, Kontakt, Galerie, Footer-Bereich). Wix-Palette --color_42."
      },
      "sand": {
        "$type": "color",
        "$value": "#DED8C3",
        "$description": "Heller Sandton der Wix-Palette (--color_44); auf der Live-Seite derzeit nicht sichtbar verwendet."
      },
      "black": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Fließtext und Überschriften auf hellem Grund. Wix setzt teils #010101."
      },
      "white": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Text auf Bildern (Hero), Seitenhintergrund Leistungen und Service-Seiten."
      }
    },
    "overlay": {
      "dark-70": {
        "$type": "color",
        "$value": "#010101B3",
        "$description": "Schwarz mit 70 % Deckkraft, Überlagerung auf Bildern."
      },
      "light-65": {
        "$type": "color",
        "$value": "#F7F7F7A6",
        "$description": "Hellgrau mit 65 % Deckkraft, Überlagerung."
      },
      "white-80": {
        "$type": "color",
        "$value": "#FFFFFFCC",
        "$description": "Weiß mit 80 % Deckkraft."
      }
    },
    "imagery": {
      "$description": "Dominante Töne der Bildwelt (Durchschnitt über alle Fotos, ohne Icons). Nur als Orientierung für neue Bilder und Akzente.",
      "nude": {
        "$type": "color",
        "$value": "#DBB99F"
      },
      "rose-brown": {
        "$type": "color",
        "$value": "#B08477"
      },
      "blush": {
        "$type": "color",
        "$value": "#FED7D7"
      },
      "caramel": {
        "$type": "color",
        "$value": "#C79379"
      },
      "peach": {
        "$type": "color",
        "$value": "#EEC3AE"
      },
      "mocha": {
        "$type": "color",
        "$value": "#754842"
      },
      "taupe": {
        "$type": "color",
        "$value": "#B19A98"
      }
    },
    "system": {
      "$description": "Von Wix bzw. Browser gesetzte Farben ohne Markenbezug; nicht für neue Gestaltung verwenden.",
      "link-default": {
        "$type": "color",
        "$value": "#0000EE",
        "$description": "Browser-Standard-Linkfarbe auf 12 Seiten."
      },
      "placeholder-gray": {
        "$type": "color",
        "$value": "#CCCCCC",
        "$description": "Leerer Platzhalter-Block auf 3 Service-Seiten."
      },
      "booking-blue": {
        "$type": "color",
        "$value": "#54ADEF",
        "$description": "Akzent im Wix-Bookings-/Social-Bereich der Service-Seiten."
      },
      "text-dark-gray": {
        "$type": "color",
        "$value": "#212121"
      }
    }
  },
  "font": {
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Libre Baskerville",
        "serif"
      ],
      "$description": "Fließtext 16 px, Überschriften 20 px (Regular 400, Bold 700). Als eigene Schrift im Wix-Konto hochgeladen."
    },
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Cormorant Garamond",
        "serif"
      ],
      "$description": "Hero-Titel „Time Out / Kosmetikinstitut“, Light, 65 px."
    },
    "script": {
      "$type": "fontFamily",
      "$value": [
        "Alex Brush",
        "cursive"
      ],
      "$description": "Schreibschrift-Zeile „Lassen Sie sich rundum verwöhnen…“, 48 px."
    },
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Open Sans",
        "sans-serif"
      ],
      "$description": "Hero-Text der Startseite (37 px) und Texte auf Leistungen (16 px)."
    },
    "widget": {
      "$type": "fontFamily",
      "$value": [
        "Arial",
        "Helvetica",
        "sans-serif"
      ],
      "$description": "Von Wix-Widgets (Bookings, Formulare) gesetzt, nicht gestaltet."
    }
  },
  "target": {
    "$description": "Zielwerte des Redesigns (#12). Status: Angenommen (Entwürfe freigegeben 2026-10-09); auf der Live-Seite nach Umsetzung in Wix.",
    "color": {
      "bg": {
        "cream": {
          "$type": "color",
          "$value": "#F5EEE4",
          "$description": "Grund aller Seiten"
        },
        "sand": {
          "$type": "color",
          "$value": "#E4D8CF",
          "$description": "Abschnitte und Karten, im Wechsel mit Creme"
        },
        "taupe": {
          "$type": "color",
          "$value": "#CAB6A2",
          "$description": "Kräftige Abschnitte, Icon-Kreise"
        },
        "espresso": {
          "$type": "color",
          "$value": "#383028",
          "$description": "Dunkler Bereich (Footer)"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "#383028",
          "$description": "Fließtext und Überschriften"
        },
        "secondary": {
          "$type": "color",
          "$value": "#6C5946",
          "$description": "Zweittext, Kapitälchen, Bildunterschriften"
        },
        "on-dark": {
          "$type": "color",
          "$value": "#F5EEE4",
          "$description": "Text auf Espresso"
        }
      },
      "accent": {
        "gold": {
          "$type": "color",
          "$value": "#987848",
          "$description": "Nur große Schrift (≥ 24 px) auf Creme, Linien, Icons"
        },
        "gold-deep": {
          "$type": "color",
          "$value": "#725A36",
          "$description": "Links und Hover auf Creme und Sand"
        },
        "gold-light": {
          "$type": "color",
          "$value": "#C9A96E",
          "$description": "Akzente und Links auf Espresso"
        }
      },
      "line": {
        "decor": {
          "$type": "color",
          "$value": "#CAB6A2",
          "$description": "Dekorative Trennlinien"
        },
        "field": {
          "$type": "color",
          "$value": "#6C5946",
          "$description": "Rahmen von Formularfeldern (≥ 3:1)"
        }
      },
      "button": {
        "primary": {
          "bg": {
            "$type": "color",
            "$value": "#383028",
            "$description": "Primär-Button"
          },
          "text": {
            "$type": "color",
            "$value": "#F5EEE4",
            "$description": "Text Primär-Button"
          },
          "bg-hover": {
            "$type": "color",
            "$value": "#2C241C",
            "$description": "Primär-Button Hover"
          }
        },
        "secondary": {
          "border": {
            "$type": "color",
            "$value": "#383028",
            "$description": "Sekundär-Button Rahmen und Text"
          },
          "bg-hover": {
            "$type": "color",
            "$value": "#E4D8CF",
            "$description": "Sekundär-Button Hover"
          }
        },
        "disabled": {
          "bg": {
            "$type": "color",
            "$value": "#E4D8CF",
            "$description": "Inaktiver Button"
          },
          "text": {
            "$type": "color",
            "$value": "#6C5946",
            "$description": "Text inaktiver Button"
          }
        }
      },
      "logo": {
        "$description": "Farben des JD-Logos, gemessen am Original. Nur im Logo und seinen Ableitungen, nicht als Text- oder Flächenfarbe.",
        "gold-dark": {
          "$type": "color",
          "$value": "#705010",
          "$description": "Ring-Verlauf, dunkles Ende"
        },
        "gold-mid": {
          "$type": "color",
          "$value": "#C09729",
          "$description": "Ring-Verlauf, Mitte"
        },
        "gold-light": {
          "$type": "color",
          "$value": "#F0C010",
          "$description": "Ring-Verlauf, helles Ende"
        },
        "line": {
          "$type": "color",
          "$value": "#807F7F",
          "$description": "Linienzeichnung (J, D, Gesicht)"
        },
        "lettering": {
          "$type": "color",
          "$value": "#000000",
          "$description": "Schriftzug „Cosmetic“ im Original"
        }
      }
    },
    "contrast": {
      "$description": "Erlaubte Kombinationen. size: normal = 4,5:1, large = 3:1 (≥ 24 px bzw. ≥ 18,7 px fett), ui = 3:1 (Bedienelemente). Kontraste geprüft.",
      "pairs": [
        [
          "text.primary",
          "bg.cream",
          "normal"
        ],
        [
          "text.primary",
          "bg.sand",
          "normal"
        ],
        [
          "text.primary",
          "bg.taupe",
          "normal"
        ],
        [
          "text.secondary",
          "bg.cream",
          "normal"
        ],
        [
          "text.secondary",
          "bg.sand",
          "normal"
        ],
        [
          "text.secondary",
          "bg.taupe",
          "large"
        ],
        [
          "accent.gold",
          "bg.cream",
          "large"
        ],
        [
          "accent.gold-deep",
          "bg.cream",
          "normal"
        ],
        [
          "accent.gold-deep",
          "bg.sand",
          "normal"
        ],
        [
          "text.on-dark",
          "bg.espresso",
          "normal"
        ],
        [
          "accent.gold-light",
          "bg.espresso",
          "normal"
        ],
        [
          "button.primary.text",
          "button.primary.bg",
          "normal"
        ],
        [
          "button.primary.text",
          "button.primary.bg-hover",
          "normal"
        ],
        [
          "button.secondary.border",
          "bg.cream",
          "normal"
        ],
        [
          "button.secondary.border",
          "button.secondary.bg-hover",
          "normal"
        ],
        [
          "button.disabled.text",
          "button.disabled.bg",
          "normal"
        ],
        [
          "line.field",
          "bg.cream",
          "ui"
        ],
        [
          "line.field",
          "bg.sand",
          "ui"
        ]
      ]
    },
    "font": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "Cormorant Garamond",
          "serif"
        ],
        "$description": "Überschriften H1–H3, Schnitte 500/600"
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Montserrat",
          "sans-serif"
        ],
        "$description": "Fließtext, Kapitälchen, Buttons, Wix-Widgets; Schnitte 400/500/600"
      },
      "script": {
        "$type": "fontFamily",
        "$value": [
          "Alex Brush",
          "cursive"
        ],
        "$description": "Akzent, höchstens eine Zeile je Seite, ab 32 px"
      }
    },
    "textStyle": {
      "h1": {
        "font": "heading",
        "weight": 500,
        "size": "56px",
        "size-mobile": "40px",
        "lineHeight": 1.1
      },
      "h2": {
        "font": "heading",
        "weight": 500,
        "size": "40px",
        "size-mobile": "30px",
        "lineHeight": 1.15
      },
      "h3": {
        "font": "heading",
        "weight": 600,
        "size": "26px",
        "size-mobile": "22px",
        "lineHeight": 1.2
      },
      "overline": {
        "font": "body",
        "weight": 500,
        "size": "13px",
        "letterSpacing": "0.18em",
        "transform": "uppercase",
        "color": "text.secondary"
      },
      "body": {
        "font": "body",
        "weight": 400,
        "size": "16px",
        "lineHeight": 1.7
      },
      "small": {
        "font": "body",
        "weight": 400,
        "size": "14px",
        "lineHeight": 1.6
      },
      "button": {
        "font": "body",
        "weight": 600,
        "size": "14px",
        "letterSpacing": "0.12em",
        "transform": "uppercase"
      },
      "script": {
        "font": "script",
        "weight": 400,
        "size": "44px",
        "size-mobile": "34px"
      }
    }
  }
}
